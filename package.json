{
  "name": "@delta-lang/cli",
  "version": "1.0.0",
  "description": "Delta — Universal Code Transformation Language",
  "keywords": ["delta", "code-transform", "refactor", "migration", "language"],
  "author": "Delta Language Contributors",
  "license": "MIT",
  "homepage": "https://delta-lang.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/delta-lang/delta"
  },
  "bin": {
    "delta": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "grammars", "schemas"],
  "scripts": {
    "build":   "tsc -p tsconfig.json",
    "dev":     "tsc -p tsconfig.json --watch",
    "test":    "jest --coverage",
    "lint":    "eslint src/**/*.ts",
    "release": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "tree-sitter":        "^0.21.1",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-go":     "^0.21.0",
    "tree-sitter-rust":   "^0.21.0",
    "tree-sitter-java":   "^0.21.0",
    "typescript":         "^5.4.0",
    "glob":               "^10.3.12",
    "chalk":              "^5.3.0",
    "commander":          "^12.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "diff":               "^5.2.0",
    "fast-glob":          "^3.3.2",
    "ora":                "^8.0.1"
  },
  "devDependencies": {
  "@types/node":  "^20.0.0",
  "@types/diff":  "^5.2.1",
  "jest":         "^29.7.0",
  "ts-jest":      "^29.1.2",
  "eslint":       "^8.57.0",
  "@typescript-eslint/parser":  "^7.0.0",
  "@typescript-eslint/eslint-plugin": "^7.0.0"
},
  "engines": { "node": ">=18.0.0" }
}
